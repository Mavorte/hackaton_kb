# --- Hackathonovy AWS ucet (viz README, sekce "Hackathonovy AWS ucet") ---
# Zadne pristupove klice: CLI jede pres SSO (aws configure sso -> profil "hackathon"; aws sso login --profile hackathon).
AWS_PROFILE=hackathon
# Vse se tvori a vola ve Frankfurtu (SSO region pro prihlaseni je eu-north-1, jen v aws configure sso).
AWS_REGION=eu-central-1

# Claude jde jen pres EU profily (prefix eu.). Claude 5 na uctu neni. Jine modely: python scripts/check_aws.py
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
UW_MODEL_FAST=eu.anthropic.claude-haiku-4-5-20251001-v1:0
UW_MODEL_STRONG=eu.anthropic.claude-sonnet-4-5-20250929-v1:0
UW_MODEL_HARD=eu.anthropic.claude-opus-4-5-20251101-v1:0
# Sdileny limit tymu: Claude 50 pozadavku/min (Opus 25). Lokalni brzda (0 = vypnuto):
BEDROCK_MAX_RPM=40

# Embeddingy: Titan v seznamu modelu hackathonu neni, over python scripts/check_aws.py.
# Kdyz neni dostupny: EMBED_PROVIDER=mock (lexikalni hash, staci pro dokumenty stejne sablony).
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_PROVIDER=

DATABASE_URL=sqlite:///data/kb.db

# volitelne
OPENSANCTIONS_API_KEY=

# offline vyvoj bez AWS a bez site
# LLM_PROVIDER=mock   # misto Bedrocku vraci ukazkove odpovedi (/kyb pouzije pravidla)
# OFFLINE=1           # ARES/VIES cte data/samples/ares/*.json
LLM_PROVIDER=bedrock
OFFLINE=0
