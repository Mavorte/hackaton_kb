# AWS - jedna z moznosti:
#  a) profil z ~/.aws/credentials nebo SSO (aws configure sso)
AWS_PROFILE=hackathon
#  b) klice primo (hackaton kredity / soukromy ucet)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
#  c) Bedrock API key (boto3 ji cte sama)
AWS_BEARER_TOKEN_BEDROCK=

AWS_REGION=eu-north-1
# over seznamem: python scripts/check_aws.py
BEDROCK_MODEL_ID=eu.anthropic.claude-sonnet-5-5
# jiny model jen zmenou ID, napr. Opus 5.5 - presne ID vypise check_aws.py (u Bedrocku muze mit prefix regionu, napr. eu.)

DATABASE_URL=sqlite:///data/kb.db

# volitelne
OPENSANCTIONS_API_KEY=

# offline vyvoj bez AWS a bez site
# LLM_PROVIDER=mock   # misto Bedrocku vraci ukazkove odpovedi (/kyb pouzije pravidla)
# OFFLINE=1           # ARES/VIES cte data/samples/ares/*.json
LLM_PROVIDER=bedrock
OFFLINE=0
